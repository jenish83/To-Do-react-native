# Copy this file to ".env" and change the values.
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/todo_app
# Or MongoDB Atlas (replace user, password and cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo_app?retryWrites=true&w=majority

# Any long random string. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
